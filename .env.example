# Public browser key; restrict its allowed origins and APIs in MapTiler.
VITE_MAPTILER_API_KEY=
# Local Vite server exposes these room-scoped token endpoints for development.
VITE_ABLY_AUTH_URL=/api/ably-auth
# Private Ably key used only by the local Vite server. Never add the VITE_ prefix.
ABLY_API_KEY=
